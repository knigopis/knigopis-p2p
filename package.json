{
  "name": "knigopis-p2p",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "legacy": "scripts/legacy.sh",
    "relay": "docker compose -f selfhost/compose.yml -f deploy/compose.dev.yml up -d",
    "relay:stop": "docker compose -f selfhost/compose.yml -f deploy/compose.dev.yml down",
    "e2e": "node e2e/flow.mjs",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "nostr-tools": "^2.25.4",
    "preact": "^11.1.0",
    "preact-iso": "^2.12.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
