# Узел Книгописи за уже работающим nginx (compose.proxy.yml). Узел слушает
# 127.0.0.1:8080, nginx держит HTTPS и передаёт ему всё: и страницы, и WebSocket.
# Сертификат — как у остальных сайтов на сервере (certbot и т. п.).

# Для WebSocket. Если такой map в конфиге уже есть, второй не нужен.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name books.example.org;

    # ssl_certificate     /etc/letsencrypt/live/books.example.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/books.example.org/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # Адрес клиента: по нему relay ограничивает частоту записи. Именно $remote_addr,
        # а не $proxy_add_x_forwarded_for: иначе клиент подставит чужой адрес сам.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
