# Скопируйте в .env и поправьте.

# Домен узла. На него должна указывать A-запись (и AAAA, если есть IPv6).
DOMAIN=knigopis.example.org

# Свой Caddy с HTTPS (вариант «чистый сервер»). Если веб-сервер на машине уже
# есть (nginx, Caddy), удалите эту строку — запустится только relay.
COMPOSE_PROFILES=web

# Узлы, с которыми синхронизироваться (в обе стороны), через пробел. Перечислите
# все узлы из src/known-relays.json: тогда пропажа любого из них не прервёт обмен
# записями. Пусто — узел ни с кем не синхронизируется.
UPSTREAM=wss://knigopis.bizibah.com

# Пауза между синхронизациями, секунд.
SYNC_INTERVAL=600

# Порт relay на 127.0.0.1 — для своего веб-сервера.
RELAY_PORT=7777

# Порты Caddy, если 80/443 заняты (тогда HTTPS сам не заработает — только для проверки).
# HTTP_PORT=80
# HTTPS_PORT=443
