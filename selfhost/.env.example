# Настройки узла: скопируйте в .env рядом с compose.yml. Обязателен только DOMAIN.

# Адрес узла. На него должна указывать A-запись (и AAAA, если есть IPv6).
DOMAIN=books.example.org

# Адреса через запятую, которые перенаправляются на DOMAIN (например, корень на www).
# REDIRECT_FROM=

# Узлы для синхронизации через пробел. По умолчанию — все известные узлы Книгописи
# (список зашит в образ при релизе), кроме этого. none — не синхронизироваться.
# UPSTREAM=
# Пауза между синхронизациями, секунд.
# SYNC_INTERVAL=600

# compose.proxy.yml: порт на 127.0.0.1, куда ваш веб-сервер передаёт запросы.
# PORT=8080

# compose.nginx-proxy.yml: если сеть nginx-proxy называется иначе.
# PROXY_NETWORK=nginx-proxy
