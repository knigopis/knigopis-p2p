# Узел Книгописи: сайт и relay на одном домене. Домен — из DOMAIN в .env;
# сертификат Caddy получит сам. За nginx-proxy этот файл подключается
# из Caddyfile.nginx-proxy, а DOMAIN внутри контейнера — «http://<адрес>», без TLS.
#
# WebSocket и запросы NIP-11 (Accept: application/nostr+json) уходят на relay,
# всё остальное — статика из ./site.

{$DOMAIN} {
	encode zstd gzip

	# Без учёта регистра: Node/undici шлёт «connection: upgrade» строчными,
	# и привычный матчер header Connection *Upgrade* его пропускает.
	@relay header_regexp Upgrade (?i)^websocket$
	handle @relay {
		reverse_proxy relay:7777 {
			# Relay режет частоту по этому адресу.
			# client_ip — адрес соединения, а за доверенным прокси (Caddyfile.nginx-proxy) —
			# адрес клиента, который прислал прокси.
			header_up X-Real-IP {client_ip}
		}
	}

	@nip11 header Accept application/nostr+json
	handle @nip11 {
		reverse_proxy relay:7777
	}

	# Архив не меняется; отсутствующий файл — честный 404, без подмены на index.html.
	handle /legacy/* {
		root * /srv
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
	}
}
