# Маршруты узла Книгописи (подключается из Caddyfile, который пишет start.sh):
# WebSocket и запросы NIP-11 (Accept: application/nostr+json) — на relay,
# всё остальное — сайт и архив из /srv.

encode zstd gzip

# Без учёта регистра: Node/undici шлёт «connection: upgrade» строчными,
# и привычный матчер header Connection *Upgrade* его пропускает.
@relay header_regexp Upgrade (?i)^websocket$
handle @relay {
	reverse_proxy 127.0.0.1:7777 {
		# Relay режет частоту записи по этому адресу. client_ip — адрес соединения,
		# а за доверенным прокси (BEHIND_PROXY) — адрес клиента, который тот прислал.
		header_up X-Real-IP {client_ip}
	}
}

@nip11 header Accept application/nostr+json
handle @nip11 {
	reverse_proxy 127.0.0.1:7777
}

# Архив не меняется; отсутствующий файл — честный 404, без подмены на index.html.
handle /legacy/* {
	root * /srv
	header Cache-Control "public, max-age=86400"
	file_server
}

handle {
	root * /srv
	try_files {path} /index.html
	file_server

	# Имена js/css содержат хеш — не меняются никогда.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Точка входа и Service Worker обязаны перепроверяться, иначе обновление
	# доходит до читателя с опозданием.
	@fresh path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
}
